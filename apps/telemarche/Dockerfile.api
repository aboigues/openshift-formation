# Télémarché — l'image de l'API, prête pour OpenShift.
#
#   podman build -f Dockerfile.api --build-arg APP_VERSION=1.0 -t telemarche-api:1.0 .
#   podman run --rm --user 12345:0 -p 8080:8080 telemarche-api:1.0     # comme sur OpenShift
#
# Deux étapes : go-toolset compile, ubi-micro exécute. Ni compilateur ni sources
# dans l'image livrée.
FROM registry.access.redhat.com/ubi10/go-toolset:10.3 AS build
WORKDIR /opt/app-root/src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
# APP_VERSION et non VERSION : go-toolset définit déjà une variable
# d'environnement VERSION, qui l'emporterait sur l'argument.
ARG APP_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=${APP_VERSION}" -o /tmp/api ./cmd/api

FROM registry.access.redhat.com/ubi10/ubi-micro:10.3
LABEL name="telemarche-api" \
      io.k8s.display-name="Télémarché API" \
      io.k8s.description="API catalogue et commandes de Télémarché" \
      io.openshift.expose-services="8080:http" \
      io.openshift.tags="go,api,telemarche" \
      org.opencontainers.image.source="https://github.com/aboigues/openshift-formation"
# Le même binaire sous deux noms : /app/migrate crée le schéma de la base.
COPY --from=build --chown=1001:0 /tmp/api /app/api
COPY --from=build --chown=1001:0 /tmp/api /app/migrate
ENV PORT=8080 LOG_LEVEL=info
USER 1001
EXPOSE 8080
ENTRYPOINT ["/app/api"]
