# Télémarché — l'image de la vitrine, prête pour OpenShift.
#
#   podman build -f Dockerfile.web --build-arg APP_VERSION=1.0 -t telemarche-web:1.0 .
#   podman run --rm --user 12345:0 -p 8080:8080 telemarche-web:1.0     # comme sur OpenShift
#
# Deux étapes : go-toolset compile, ubi-micro exécute. Ni compilateur ni sources
# dans l'image livrée.
FROM registry.access.redhat.com/ubi10/go-toolset:10.3 AS build
WORKDIR /opt/app-root/src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
# APP_VERSION et non VERSION : go-toolset définit déjà une variable
# d'environnement VERSION, qui l'emporterait sur l'argument.
ARG APP_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=${APP_VERSION}" -o /tmp/web ./cmd/web

FROM registry.access.redhat.com/ubi10/ubi-micro:10.3
LABEL name="telemarche-web" \
      io.k8s.display-name="Télémarché Web" \
      io.k8s.description="Vitrine de Télémarché : page statique et relais vers l'API" \
      io.openshift.expose-services="8080:http" \
      io.openshift.tags="go,web,telemarche" \
      org.opencontainers.image.source="https://github.com/aboigues/openshift-formation"
COPY --from=build --chown=1001:0 /tmp/web /app/web
ENV PORT=8080 LOG_LEVEL=info
USER 1001
EXPOSE 8080
ENTRYPOINT ["/app/web"]
